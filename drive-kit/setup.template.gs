/**
 * Nonfiction Hotlist: Drive editing kit setup.
 *
 * Builds the NFH folder kit that the microsite reads from:
 *   00 How this works            guide for editors
 *   01 Cover, Welcome, About/    three Google Docs + Media
 *   02 Index Pages/              Running order sheet
 *   03 Projects/<Title>/         a locked Google Sheet + Media (images)
 *   Site manifest (do not edit)  the map the publish workflow reads
 *
 * How to run: script.google.com > New project > paste this file > select buildKit > Run.
 * Approve the permissions it asks for. If it stops to stay under Google's time limit,
 * it schedules itself to continue a minute later. Running it again only fills in what's missing.
 *
 * Generated by scripts/content/build-kit.js from scripts/content/spec.js. Edit those, not this file.
 */

const KIT = __KIT__;

const C = { forest: "#2e4a3b", deep: "#22382c", sage: "#9aab8c", soft: "#c6d0bb", cream: "#ebe6d7", ink: "#1d2b23",
            locked: "#eef1e8", edit: "#ffffff", warn: "#f6e3b4", bad: "#f2c4bd" };
const FIRST_ROW = 5;            // body starts under banner (1), instructions (2), spacer (3), header (4)
const BUDGET_MS = 4.5 * 60 * 1000;

/* ============================== entry points ============================== */

function buildKit() {
  const started = Date.now();
  const state = loadState_();
  const data = loadContent_();
  const root = DriveApp.getFolderById(KIT.rootFolderId);
  const out = (msg) => Logger.log(msg);

  const front = folder_(root, "01 Cover, Welcome, About");
  const index = folder_(root, "02 Index Pages");
  const projects = folder_(root, "03 Projects");
  folder_(front, "Media");

  if (!state.guide) { state.guide = makeGuide_(root, data); saveState_(state); out("Guide written"); }

  for (const key of ["cover", "welcome", "about"]) {
    if (!state.docs[key]) { state.docs[key] = makeDoc_(front, key, data.content[key]); saveState_(state); out("Doc: " + key); }
  }

  if (!state.order) { state.order = makeOrderSheet_(index, data); saveState_(state); out("Running order"); }

  for (const slug of data.content.order) {
    const p = data.content.projects[slug];
    const rec = state.projects[slug] || (state.projects[slug] = {});
    if (rec.fileId && rec.images) continue;
    const pf = folder_(projects, p.title);
    if (!rec.fileId) {
      if (Date.now() - started > BUDGET_MS) return pause_(state);
      Object.assign(rec, makeProjectSheet_(pf, p)); saveState_(state); out("Sheet: " + p.title);
    }
    if (!rec.images) {
      if (Date.now() - started > BUDGET_MS) return pause_(state);
      copyImages_(folder_(pf, "Media"), data.layout.projects[slug] || {});
      rec.images = true; saveState_(state); out("Images: " + p.title);
    }
  }

  if (!state.frontMedia) {
    const media = folder_(front, "Media");
    if (!media.getFilesByName("Share image.jpg").hasNext())
      media.createFile(UrlFetchApp.fetch(KIT.siteBase + "og.jpg").getBlob().setName("Share image.jpg"));
    state.frontMedia = true; saveState_(state);
  }

  state.manifest = writeManifest_(root, state, data);
  saveState_(state);

  // Link sharing so the publish workflow can read the kit without signing in. Editing stays
  // limited to the people you add.
  root.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
  allFileIds_(state).forEach(id => DriveApp.getFileById(id).setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW));

  clearTriggers_();
  out("Done. Site manifest ID: " + state.manifest);
  out("Send this ID to Claude to connect the kit to the website.");
}

/** Keeps going after a pause. Called by the time trigger buildKit sets up. */
function continueKit() { buildKit(); }

/** Forgets progress so the next run builds everything again (files already made are not deleted). */
function resetKit() { PropertiesService.getScriptProperties().deleteProperty("kit"); clearTriggers_(); }

/* ============================== state ============================== */

function loadState_() {
  const raw = PropertiesService.getScriptProperties().getProperty("kit");
  return raw ? JSON.parse(raw) : { docs: {}, projects: {} };
}
function saveState_(s) { PropertiesService.getScriptProperties().setProperty("kit", JSON.stringify(s)); }
function pause_(state) {
  saveState_(state);
  clearTriggers_();
  ScriptApp.newTrigger("continueKit").timeBased().after(60 * 1000).create();
  Logger.log("Paused to stay under Google's time limit. It will continue on its own in about a minute.");
}
function clearTriggers_() {
  ScriptApp.getProjectTriggers().filter(t => t.getHandlerFunction() === "continueKit").forEach(t => ScriptApp.deleteTrigger(t));
}
function loadContent_() {
  const get = url => JSON.parse(UrlFetchApp.fetch(url).getContentText());
  return { content: get(KIT.contentUrl), layout: get(KIT.layoutUrl) };
}
function allFileIds_(state) {
  const ids = [state.guide, state.order && state.order.fileId, state.manifest];
  Object.values(state.docs).forEach(id => ids.push(id));
  Object.values(state.projects).forEach(r => ids.push(r.fileId));
  return ids.filter(Boolean);
}

/* ============================== Drive helpers ============================== */

function folder_(parent, name) {
  const it = parent.getFoldersByName(name);
  return it.hasNext() ? it.next() : parent.createFolder(name);
}
function moveTo_(id, folder) { DriveApp.getFileById(id).moveTo(folder); return id; }

/* ============================== project sheets ============================== */

function makeProjectSheet_(folder, p) {
  const ss = SpreadsheetApp.create(p.title);
  moveTo_(ss.getId(), folder);
  const tabs = {};

  // Page tab: one row per field.
  const page = ss.getSheets()[0].setName("Page");
  const fields = KIT.spec.PROJECT.page;
  frame_(page, p.title, "Edit the white cells in the Text column. Each field has a character limit; text over the limit is refused. " +
    "Changes appear on the website within about 15 minutes. Other tabs: Team, How to help, Links, Laurels and awards, News.",
    ["Field", "Text", "Characters", "Notes"], fields.length, [170, 560, 110, 300]);
  page.getRange(FIRST_ROW, 2, fields.length, 1).setNumberFormat("@");
  page.getRange(FIRST_ROW, 1, fields.length, 4).setValues(fields.map((f, i) => {
    const r = FIRST_ROW + i;
    return [f.label, p[f.key] || "", f.max ? `=IF(LEN(B${r})=0,"",LEN(B${r})&" / ${f.max}")` : "", f.hint || ""];
  }));
  fields.forEach((f, i) => {
    const r = FIRST_ROW + i;
    page.getRange(r, 2).setDataValidation(rule_(f, `B${r}`));
    if (f.multiline) page.setRowHeight(r, 160);
    if (f.max) warnFormat_(page, page.getRange(r, 3), `=LEN($B${r})>${Math.floor(f.max * 0.9)}`);
  });
  page.getRange(FIRST_ROW, 2, fields.length, 1).setBackground(C.edit).setWrap(true);
  lock_(page, [page.getRange(FIRST_ROW, 2, fields.length, 1)]);
  tabs.Page = page.getSheetId();

  // List tabs
  for (const list of KIT.spec.PROJECT.lists) {
    const sh = ss.insertSheet(list.tab);
    const widths = list.cols.map(c => c.type === "year" ? 80 : c.max && c.max > 100 ? (c.type === "url" ? 300 : 460) : 220);
    const limits = list.cols.filter(c => c.max && c.type !== "url").map(c => `${c.label} ${c.max}`).join(", ");
    const notes = { team: "One person per row.", help: "One need per row, most important first.", links: "Full links starting with https://",
      laurels: "Festivals, awards, grants. Year and a source link are optional but recommended.",
      updates: "Newest first. Every item needs a source link or it won't appear." }[list.key];
    frame_(sh, `${p.title} · ${list.tab}`, `${notes} Up to ${list.rows} rows. Character limits: ${limits || "none"}.`,
      list.cols.map(c => c.label), list.rows, widths);
    list.cols.forEach((c, j) => sh.getRange(FIRST_ROW, j + 1, list.rows, 1).setNumberFormat(c.type === "year" ? "0" : "@"));
    const rows = (p[list.key] || []).slice(0, list.rows).map(item => toRow_(list.key, item));
    if (rows.length) sh.getRange(FIRST_ROW, 1, rows.length, list.cols.length).setValues(rows);
    list.cols.forEach((c, j) => {
      const col = String.fromCharCode(65 + j);
      sh.getRange(FIRST_ROW, j + 1, list.rows, 1).setDataValidation(rule_(c, `${col}${FIRST_ROW}`));
    });
    const body = sh.getRange(FIRST_ROW, 1, list.rows, list.cols.length);
    body.setBackground(C.edit).setWrap(true);
    lock_(sh, [body]);
    tabs[list.tab] = sh.getSheetId();
  }
  page.activate();
  SpreadsheetApp.flush();
  return { fileId: ss.getId(), tabs };
}

function toRow_(key, item) {
  if (key === "help") return [item];
  if (key === "laurels") return [item.event, item.year || "", item.note || "", item.source || ""];
  if (key === "updates") return [item.date, item.text, item.source || "", item.url || ""];
  return item;
}

// Banner, instructions, header row; body rows below. Columns past the table are hidden.
function frame_(sh, title, note, header, bodyRows, widths) {
  const n = header.length;
  sh.clear();
  const total = FIRST_ROW - 1 + bodyRows;
  if (sh.getMaxRows() > total) sh.deleteRows(total + 1, sh.getMaxRows() - total);
  if (sh.getMaxColumns() > n) sh.deleteColumns(n + 1, sh.getMaxColumns() - n);
  const banner = n > 1 ? sh.getRange(1, 1, 1, n).merge() : sh.getRange(1, 1);
  banner.setValue(title).setFontSize(15).setFontWeight("bold").setFontColor(C.cream).setBackground(C.forest)
    .setVerticalAlignment("middle");
  sh.setRowHeight(1, 40);
  (n > 1 ? sh.getRange(2, 1, 1, n).merge() : sh.getRange(2, 1)).setValue(note).setWrap(true).setFontColor(C.ink).setBackground(C.soft).setVerticalAlignment("middle");
  sh.setRowHeight(2, 48);
  sh.getRange(3, 1, 1, n).setBackground(C.locked);
  sh.setRowHeight(3, 8);
  sh.getRange(4, 1, 1, n).setValues([header]).setFontWeight("bold").setFontColor(C.cream).setBackground(C.deep);
  sh.getRange(FIRST_ROW, 1, bodyRows, n).setBackground(C.locked).setVerticalAlignment("top").setFontColor(C.ink);
  widths.forEach((w, i) => sh.setColumnWidth(i + 1, w));
  sh.setFrozenRows(4);
  sh.getRange(1, 1, total, n).setFontFamily("Arial");
}

function rule_(f, cell) {
  const b = SpreadsheetApp.newDataValidation().setAllowInvalid(false);
  if (f.type === "email") return b.requireTextIsEmail().setHelpText("An email address").build();
  if (f.type === "url") return b.requireTextIsUrl().setHelpText("A full link starting with https://").build();
  if (f.type === "year") return b.requireNumberBetween(1990, 2100).setHelpText("A year, like 2026").build();
  return b.requireFormulaSatisfied(`=LEN(${cell})<=${f.max}`).setHelpText(`Up to ${f.max} characters`).build();
}

function warnFormat_(sh, range, formula) {
  const rules = sh.getConditionalFormatRules();
  rules.push(SpreadsheetApp.newConditionalFormatRule().whenFormulaSatisfied(formula).setBackground(C.warn).setRanges([range]).build());
  sh.setConditionalFormatRules(rules);
}

// Protects the whole tab except the editable ranges. Only the owner can change the layout.
function lock_(sh, editable) {
  const p = sh.protect().setDescription("Layout is locked. Edit the white cells.");
  p.setUnprotectedRanges(editable);
  const me = Session.getEffectiveUser();
  p.addEditor(me);
  p.removeEditors(p.getEditors().filter(u => u.getEmail() !== me.getEmail()));
  if (p.canDomainEdit()) p.setDomainEdit(false);
}

/* ============================== running order ============================== */

function makeOrderSheet_(folder, data) {
  const c = data.content;
  const O = KIT.spec.ORDER;
  const slots = O.pages * O.perPage;
  const ss = SpreadsheetApp.create("Running order");
  moveTo_(ss.getId(), folder);
  const sh = ss.getSheets()[0].setName(O.tab);
  frame_(sh, `The ${c.year} Nonfiction Hotlist · Running order`,
    `Pick a project for each slot. ${O.perPage} projects per index page, ${O.pages} pages. The card text and image come from each project's sheet. ` +
    "A project picked twice keeps its first slot; a project left out is added at the end.",
    ["Page", "Slot", "Project"], slots, [110, 70, 420]);
  const labels = c.order.map(s => c.projects[s].title);
  const rows = [];
  for (let i = 0; i < slots; i++) rows.push([`Page ${Math.floor(i / O.perPage) + 1}`, (i % O.perPage) + 1, labels[i] || ""]);
  sh.getRange(FIRST_ROW, 3, slots, 1).setNumberFormat("@");
  sh.getRange(FIRST_ROW, 1, slots, 3).setValues(rows);
  const pick = sh.getRange(FIRST_ROW, 3, slots, 1);
  pick.setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(labels.slice().sort(), true).setAllowInvalid(false).build())
    .setBackground(C.edit);
  const dup = SpreadsheetApp.newConditionalFormatRule()
    .whenFormulaSatisfied(`=AND($C${FIRST_ROW}<>"",COUNTIF($C$${FIRST_ROW}:$C$${FIRST_ROW + slots - 1},$C${FIRST_ROW})>1)`)
    .setBackground(C.bad).setRanges([pick]).build();
  const band = SpreadsheetApp.newConditionalFormatRule().whenFormulaSatisfied(`=ISEVEN(VALUE(RIGHT($A${FIRST_ROW},1)))`)
    .setBackground("#e3e8da").setRanges([sh.getRange(FIRST_ROW, 1, slots, 2)]).build();
  sh.setConditionalFormatRules([dup, band]);
  lock_(sh, [pick]);
  return { fileId: ss.getId(), tabs: { [O.tab]: sh.getSheetId() } };
}

/* ============================== docs ============================== */

function makeDoc_(folder, key, d) {
  const spec = KIT.spec.DOCS[key];
  const doc = DocumentApp.create(spec.title);
  moveTo_(doc.getId(), folder);
  const body = doc.getBody();
  body.clear();
  const first = body.getParagraphs()[0];
  first.setText(spec.title);                       // Paragraph.setText returns nothing, so no chaining
  first.setHeading(DocumentApp.ParagraphHeading.HEADING1);
  note_(body, "Edit the text under each heading, and keep the headings exactly as they are. " +
    (key === "cover" ? "" : "Bold text shows on the site with the sage marker highlight. ") +
    "Changes appear on the website within about 15 minutes.");
  for (const s of spec.sections) {
    body.appendParagraph(s.heading).setHeading(DocumentApp.ParagraphHeading.HEADING2);
    const v = d[s.key];
    const limit = s.kind === "steps" ? `Up to ${s.maxItems} steps. Step names up to ${s.maxTitle} characters, text up to ${s.max}.`
      : s.maxItems ? `Up to ${s.maxItems} ${s.kind === "bullets" ? "items" : "paragraphs"}, ${s.max} characters each.`
      : `Up to ${s.max} characters.`;
    note_(body, limit);
    if (s.kind === "text") rich_(body.appendParagraph(""), v);
    if (s.kind === "paragraphs") v.forEach(t => rich_(body.appendParagraph(""), t));
    if (s.kind === "bullets") v.forEach(t => body.appendListItem(t).setGlyphType(DocumentApp.GlyphType.BULLET));
    if (s.kind === "steps") v.forEach(([h, t]) => {
      body.appendParagraph(h).setHeading(DocumentApp.ParagraphHeading.HEADING3);
      body.appendParagraph(t);
    });
  }
  doc.saveAndClose();
  return doc.getId();
}

// Small grey italic guidance line. It sits under a heading and is ignored by the website,
// as long as it stays italic.
function note_(body, text) {
  const p = body.appendParagraph(text).setHeading(DocumentApp.ParagraphHeading.NORMAL);
  p.editAsText().setItalic(true).setForegroundColor("#7a8573").setFontSize(9);
  return p;
}

// Writes text with **bold** marks as real bold.
function rich_(para, text) {
  const parts = String(text).split("**");
  para.setText(parts.join(""));
  const t = para.editAsText();
  let pos = 0;
  parts.forEach((part, i) => {
    if (i % 2 === 1 && part.length) t.setBold(pos, pos + part.length - 1, true);
    pos += part.length;
  });
  return para;
}

function makeGuide_(root, data) {
  const doc = DocumentApp.create("00 How this works");
  moveTo_(doc.getId(), root);
  const b = doc.getBody();
  b.clear();
  const first = b.getParagraphs()[0];
  first.setText(`The ${data.content.year} Nonfiction Hotlist · How this works`);
  first.setHeading(DocumentApp.ParagraphHeading.HEADING1);
  const H = t => b.appendParagraph(t).setHeading(DocumentApp.ParagraphHeading.HEADING2);
  const P = t => b.appendParagraph(t);
  const L = t => b.appendListItem(t).setGlyphType(DocumentApp.GlyphType.BULLET);
  P(`This folder is the source for the website at ${KIT.siteUrl}. Edit the sheets and docs here, and the site and its PDF update on their own, usually within 15 minutes.`);
  H("What's where");
  L("01 Cover, Welcome, About: the opening pages, as Google Docs. Bold text becomes the sage highlight.");
  L("02 Index Pages: the running order. Each slot is a dropdown of project names.");
  L("03 Projects: one folder per project, each with a locked Google Sheet and a Media folder.");
  L("Site manifest: the map the website reads. Don't edit, move or rename it.");
  H("Project sheets");
  L("Edit only the white cells. The layout is locked so nothing can be moved or deleted by accident.");
  L("Each field has a character limit. Text over the limit is refused, and the counter turns amber near the limit.");
  L("Tabs: Page, Team, How to help, Links, Laurels and awards, News. News items need a source link.");
  H("If something doesn't show up");
  L("A change that breaks a rule (too long, a missing heading in a doc, a link without https://) is skipped, and the site keeps the previous text. The site owner gets an email listing what was skipped.");
  L(`To publish right away instead of waiting, the site owner can run the Publish workflow: ${KIT.repoUrl}/actions`);
  L("Every sheet and doc keeps version history (File > Version history) if you need to roll back.");
  H("Images");
  L("Images in each Media folder are copies of what's on the site. To change one, add the new image to the Media folder and tell the site owner. Image changes are applied by hand so framing and cropping stay right.");
  H("House style");
  L("Understated and direct. No em dashes.");
  L("Project contact details belong to the filmmakers.");
  doc.saveAndClose();
  return doc.getId();
}

/* ============================== images ============================== */

function copyImages_(media, l) {
  const list = [];
  if (l.key) list.push([l.key, "01 Key art.jpg"]);
  if (l.hero) list.push([l.hero, "02 Banner.jpg"]);
  (l.stills || []).forEach((s, i) => list.push([s[0], `${String(i + 3).padStart(2, "0")} Still ${i + 1}.jpg`]));
  list.forEach(([src, name]) => {
    if (media.getFilesByName(name).hasNext()) return;
    media.createFile(UrlFetchApp.fetch(KIT.siteBase + src).getBlob().setName(name));
  });
}

/* ============================== manifest ============================== */

function writeManifest_(root, state, data) {
  let ss;
  if (state.manifest) ss = SpreadsheetApp.openById(state.manifest);
  else { ss = SpreadsheetApp.create("Site manifest (do not edit)"); moveTo_(ss.getId(), root); }
  const sh = ss.getSheets()[0].setName("Files");
  const rows = [["Kind", "Key", "Label", "File ID", "Tabs"]];
  data.content.order.forEach(slug => {
    const r = state.projects[slug];
    if (r && r.fileId) rows.push(["project", slug, data.content.projects[slug].title, r.fileId, JSON.stringify(r.tabs)]);
  });
  rows.push(["order", "order", "Running order", state.order.fileId, JSON.stringify(state.order.tabs)]);
  Object.entries(state.docs).forEach(([k, id]) => rows.push(["doc", k, KIT.spec.DOCS[k].title, id, "{}"]));
  sh.clear();
  sh.getRange(1, 1, rows.length, 5).setValues(rows);
  sh.getRange(1, 1, 1, 5).setFontWeight("bold");
  sh.getProtections(SpreadsheetApp.ProtectionType.SHEET).forEach(p => p.remove());
  lock_(sh, []);
  return ss.getId();
}
